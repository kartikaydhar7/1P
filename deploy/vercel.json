{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/qos/:path*", "destination": "https://replace-with-qos-host.invalid/:path*" }
  ]
}
